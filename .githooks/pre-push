#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
fail() { echo "pre-push: $*" >&2; exit 1; }
head=$(git rev-parse --verify 'HEAD^{commit}')
seen=0
updates=0
while read -r local_ref local_oid remote_ref remote_oid extra || [ -n "${local_ref:-}" ]; do
  seen=1
  [ -n "$remote_oid" ] && [ -z "$extra" ] || fail 'Invalid pre-push input; expected four fields per ref.'
  for oid in "$local_oid" "$remote_oid"; do
    case "$oid" in ''|*[!0-9a-f]*) fail 'Invalid object ID.' ;; esac
    [ "${#oid}" -eq 40 ] || [ "${#oid}" -eq 64 ] || fail 'Invalid object ID length.'
  done
  case "$local_oid" in *[!0]*) ;; *) continue ;; esac
  commit=$(git rev-parse --verify "$local_oid^{commit}")
  [ "$commit" = "$head" ] || fail 'Every pushed ref must resolve to checked-out HEAD. Check out and validate different commits separately.'
  updates=1
done
[ "$seen" -eq 0 ] || [ "$updates" -ne 0 ] || exit 0
status=$(git status --porcelain=v1 --untracked-files=normal)
[ -z "$status" ] || fail 'Clean checkout required, including untracked files. No automatic stash or checkout.'
command -v rustup >/dev/null 2>&1 || fail 'Install the pinned Rust 1.95.0 toolchain with rustfmt and prepare dependencies. See docs/ci-runners.md.'
rustup run 1.95.0 rustc --version >/dev/null 2>&1 || fail 'Rust 1.95.0 is not installed. Bootstrap it explicitly before pushing.'
# Full graph checks avoid uncertain diff bases and never fetch or bootstrap from a hook.
rustup run 1.95.0 cargo fmt --all -- --check
rustup run 1.95.0 cargo check --locked --offline --workspace --all-targets
